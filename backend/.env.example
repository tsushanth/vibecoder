SUPABASE_URL=
SUPABASE_ANON_KEY=
WORKER_URL=http://localhost:3456
WORKER_SECRET=vibecoder-worker-secret
DEPLOY_SERVER_URL=http://localhost:4000
STRIPE_SECRET_KEY=
PORT=8080

# Mobile purchases (RevenueCat project proj30e3762b). Fly is the source of truth for real values.
# Shared secret the RevenueCat dashboard sends in the Authorization header of POST /api/webhooks/revenuecat. Unset = the endpoint answers 503.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat secret API key (REST v1). Optional: only needed for TRANSFER events and POST /api/subscriptions/verify. Unset = those stay off.
REVENUECAT_SECRET_API_KEY=
